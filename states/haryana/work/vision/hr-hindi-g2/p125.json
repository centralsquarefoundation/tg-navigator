          "sections": [
            {"number": "1.1", "heading": "कविता/बालगीत गाना", "minutes": "5",
             "items": [
               {"type": "bullet", "text": "शिक्षक कविता/बालगीत को हाव-भाव और लय के साथ गाकर सुनाएँ। बच्चे पीछे-पीछे दोहरायें।"}
             ], "sections": []},
            {"number": "1.2", "heading": "सृजनात्मक गतिविधि", "minutes": "20",
             "items": [
               {"type": "text", "text": "‘चलो अपना स्कूल बनाएँ’"},
               {"type": "bullet", "text": "बच्चों से पहले गाँव के बारे में चर्चा करें (घर, पेड़, जानवर, खेत, स्कूल आदि)।"},
               {"type": "bullet", "text": "अब विषय दें: अगर आपको एक स्कूल बनाना है तो किन-किन चीज़ों की ज़रूरत होगी?"},
               {"type": "bullet", "text": "बच्चों को उत्तर देने दें और मुख्य बिंदु बोर्ड पर लिखें।"},
               {"type": "bullet", "text": "फिर बच्चों को जोड़ों में बाँटकर 10 मिनट दें ताकि वे अपनी सूची बना सकें।"},
               {"type": "bullet", "text": "आखिरी 10 मिनट में हर जोड़ी अपना प्रस्तुतिकरण करेगी।"}
             ], "sections": []}
          ]
        },
        {
          "number": "2", "heading": "डिकोडिंग", "minutes": "40",
          "items": [],
          "sections": [
            {"number": "2.1", "heading": "अभ्यास-18.5 ‘झूला’", "minutes": null,
             "items": [
               {"type": "bullet", "text": "बच्चों को पाठ का स्पष्ट उच्चारण, उतार-चढ़ाव के साथ (आदर्श) पठन कर बताएँ।"},
               {"type": "bullet", "text": "बच्चों को स्वयं व जोड़ों में पढ़वाएँ और पढ़ने में मदद करें।"}
             ], "sections": []},
            {"number": "2.2", "heading": "अभ्यास-कार्य", "minutes": null,
             "items": [
               {"type": "bullet", "text": "पाठ्यपुस्तक के अभ्यास 18.5 (पृष्ठ सं. 214) पर कहानी को पढ़ने, प्रश्नोत्तर करने, चित्र को देखकर उनके बारे में दो वाक्य लिखने और सुनकर लिखने पर अभ्यास करवाएँ।"}
             ], "sections": []}
          ]
        },
        {
          "number": "3", "heading": "पठन", "minutes": "20",
          "items": [],
          "sections": [
            {"number": "3.1", "heading": "स्वतंत्र पठन", "minutes": null,
             "items": [
               {"type": "bullet", "text": "बच्चों को पुस्तकालय से मनपसंद किताब चुनकर व्यक्तिगत रूप से पढ़ने को कहें और उनके स्तर की पुस्तक चुनने में मदद करें।"},
               {"type": "bullet", "text": "पाठ के अंत में कक्षा में कहानी के पात्रों, घटनाओं आदि पर चर्चा करें।"}
             ], "sections": []}
          ]
        }
      ]
    }
