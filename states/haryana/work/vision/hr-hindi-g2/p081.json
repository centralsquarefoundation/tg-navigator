          "items": [],
          "sections": [
            {"number": "1.1", "heading": "कविता/बालगीत गाना", "minutes": "5",
             "items": [
               {"type": "bullet", "text": "बच्चों को सहज करने के लिए कोई कविता गाएँ।"},
               {"type": "bullet", "text": "कविता को लय, हाव-भाव के साथ गाकर सुनाएँ।"},
               {"type": "bullet", "text": "बच्चों को साथ में दोहराने के लिए कहें।"},
               {"type": "bullet", "text": "लय और शब्दों पर बेहतर पकड़ बनाने के लिए 2-3 बार ऐसा करें।"},
               {"type": "bullet", "text": "सुनिश्चित करें कि सभी बच्चे सहजता से कविता गाने में शामिल हों।"}
             ], "sections": []},
            {"number": "1.2", "heading": "कहानी पढ़ें", "minutes": "20",
             "items": [{"type": "bullet", "text": "पाठ्यपुस्तक से कहानी ‘दोस्त के जूते’ कहानी को सुनाएँ एवं चर्चा करें।"}], "sections": []},
            {"number": "1.3", "heading": "अभिव्यक्ति के लिए लेखन", "minutes": "5-7",
             "items": [{"type": "bullet", "text": "अपने-अपने ‘जूतों’ का चित्र। बच्चों को नोटबुक में चित्र बनाने के लिए प्रोत्साहित करें।"}], "sections": []}
          ]
        },
        {
          "number": "2", "heading": "डिकोडिंग ‘सावधिक पुनरावृत्ति’", "minutes": "40",
          "items": [],
          "sections": [
            {"number": null, "heading": "समूह-1", "minutes": null,
             "items": [
               {"type": "bullet", "text": "शिक्षक बच्चों को ग्रिड में वर्ण/अक्षर को पढ़ने पर अभ्यास करवाएँ ।"},
               {"type": "bullet", "text": "2-3 वर्णों वाले शब्दों को सुनकर लिखने (श्रुतलेख) पर अभ्यास करवाएँ।"}
             ], "sections": []},
            {"number": null, "heading": "समूह-2", "minutes": null,
             "items": [
               {"type": "text", "text": "11.4 पेज 131"},
               {"type": "bullet", "text": "समूह दो के बच्चों को शिक्षक सावधिक आकलन के साथ पाठ्यपुस्तक में दिए अभ्यास-पत्रक पर बातचीत करके स्वतंत्र रूप से कार्य करने दें।"},
               {"type": "bullet", "text": "इसके अलावा बच्चों को अब तक पढ़े पाठों में से स्वतंत्र रूप से पढ़ने और अभ्यास प्रश्नों के जवाब देने का कार्य करने को कहें।"}
             ], "sections": []}
          ]
