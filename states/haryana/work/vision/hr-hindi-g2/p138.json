            {"number": "1.1", "heading": "कविता/बालगीत गाना", "minutes": "5",
             "items": [
               {"type": "bullet", "text": "शिक्षक कविता/बालगीत को हाव-भाव और लय के साथ गाकर सुनाएँ। बच्चे पीछे-पीछे दोहरायें।"}
             ], "sections": []},
            {"number": "1.2", "heading": "बच्चों द्वारा अपने शब्दों में कहानी सुनाना", "minutes": "20",
             "items": [
               {"type": "bullet", "text": "बच्चों को जो भी कहानी उन्हें याद है उसे अपनी भाषा में सुनाने को कहें। सुनिश्चित करें कि सभी बच्चे सहजता से इस गतिविधि में शामिल हों। उन्हें प्रोत्साहित करें।"}
             ], "sections": []},
            {"number": "1.3", "heading": "अभिव्यक्ति के लिए लेखन", "minutes": "5-7",
             "items": [
               {"type": "bullet", "text": "बच्चों को उनके द्वारा सुनाई कहानी में कौन-कौन अच्छा लगा और कौन खराब, क्यों? लिखवाएँ।"},
               {"type": "bullet", "text": "लेखन कार्य के दौरान बच्चों को आवश्यकतानुसार मदद करें।"}
             ], "sections": []}
          ]
        },
        {
          "number": "2", "heading": "डिकोडिंग ‘सावधिक पुनरावृत्ति’", "minutes": "40",
          "items": [],
          "sections": [
