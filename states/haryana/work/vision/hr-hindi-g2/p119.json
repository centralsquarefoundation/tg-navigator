          "items": [],
          "sections": [
            {"number": "1.1", "heading": "कविता/बालगीत गाना", "minutes": "5",
             "items": [
               {"type": "bullet", "text": "शिक्षक कविता/बालगीत को हाव-भाव और लय के साथ गाकर सुनाएँ। बच्चे पीछे-पीछे दोहरायें।"}
             ], "sections": []},
            {"number": "1.2", "heading": "सृजनात्मक गतिविधि", "minutes": "20",
             "items": [
               {"type": "text", "text": "‘भावनाओं के भी चित्र होते हैं’"},
               {"type": "bullet", "text": "बच्चों को दो-दो के जोड़ों में बाँटें।"},
               {"type": "bullet", "text": "हर जोड़े को एक खाली पन्ना या कॉपी दें।"},
               {"type": "bullet", "text": "शिक्षक पहले की ‘भावनाएँ’ गतिविधि से वाक्य/संकेत दोबारा पढ़ें।"},
               {"type": "bullet", "text": "बच्चे उन भावनाओं को स्माइली बनाकर दिखाएँ (जैसे खुश, उदास, थके हुए, गुस्से वाले)।"},
               {"type": "bullet", "text": "शिक्षक बोर्ड पर उदाहरण के लिए एक-दो स्माइली बनाएँ। अंत में बच्चों से उनकी बनाई स्माइली और उनमें झलक रही भावनाओं पर चर्चा करें।"}
             ], "sections": []},
            {"number": "1.3", "heading": "अभिव्यक्ति के लिए लेखन", "minutes": "5-7",
             "items": [
               {"type": "bullet", "text": "दोस्त दुखी है, चित्र बनाएँ और लिखें।"}
             ], "sections": []}
          ]
        },
        {
          "number": "2", "heading": "डिकोडिंग", "minutes": "40",
          "items": [],
          "sections": [
            {"number": "2.1", "heading": "अभ्यास-17.5 ‘पालक का साग’", "minutes": null,
             "items": [
               {"type": "bullet", "text": "बच्चों को पाठ का स्पष्ट उच्चारण, उतार-चढ़ाव के साथ (आदर्श) पठन कर बताएँ।"},
               {"type": "bullet", "text": "बच्चों को स्वयं व जोड़ों में पढ़वाएँ और पढ़ने में मदद करें।"}
             ], "sections": []},
            {"number": "2.2", "heading": "अभ्यास-कार्य", "minutes": null,
             "items": [
               {"type": "bullet", "text": "पाठ्यपुस्तक के अभ्यास 17.5 (पृष्ठ सं.202) पर कहानी को पढ़ने, प्रश्नोत्तर करने, सुनकर लिखने पर अभ्यास करवाएँ।"}
             ], "sections": []}
          ]
        },
        {
          "number": "3", "heading": "पठन", "minutes": "20",
          "items": [],
          "sections": [
            {"number": "3.1", "heading": "स्वतंत्र पठन", "minutes": null,
             "items": [
               {"type": "bullet", "text": "बच्चों को पुस्तकालय से मनपसंद किताब चुनकर व्यक्तिगत रूप से पढ़ने को कहें और उनके स्तर की पुस्तक चुनने में मदद करें।"},
               {"type": "bullet", "text": "पाठ के अंत में कक्षा में कहानी के पात्रों, घटनाओं आदि पर चर्चा करें।"}
             ], "sections": []}
          ]
        }
      ]
